# Copie para backend/.env e preencha os valores reais. Nunca versione .env.
NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1993
DB_NAME=dev_cursos
DB_SSL=false
# Para TiDB/serviço gerenciado use DB_SSL=true e, quando necessário, DB_SSL_CA=/caminho/ca.pem
# O bypass só aceita DB_HOST local e inicia a API apenas em 127.0.0.1.
# Use modo strict em ambientes compartilhados e produção.
FIREBASE_AUTH_MODE=bypass
FIREBASE_PROJECT_ID=devcursos-b3589
# Quando usar autenticação real do servidor, configure GOOGLE_APPLICATION_CREDENTIALS=/caminho/service-account.json
FRONTEND_URL=http://localhost:5173

# Execução remota. Aponte para a base v2 de uma instância autorizada do Piston.
# Em desenvolvimento sem URL, Python usa o executor do navegador.
# PISTON_API_URL=http://127.0.0.1:2000/api/v2
# PISTON_API_TOKEN=
# PISTON_PYTHON_VERSION=3
# PISTON_JAVA_VERSION=*
