# Copie para Back-End/.env e preencha os valores reais. Nunca versione .env.
NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=dev_cursos
DB_SSL=false
# Para TiDB/serviço gerenciado use DB_SSL=true e, quando necessário, DB_SSL_CA=/caminho/ca.pem
# Bypass é permitido somente para desenvolvimento local sem credencial do Admin SDK.
FIREBASE_AUTH_MODE=bypass
FIREBASE_PROJECT_ID=devcursos-b3589
# Quando usar autenticação real do servidor, configure GOOGLE_APPLICATION_CREDENTIALS=/caminho/service-account.json
FRONTEND_URL=http://localhost:5173
